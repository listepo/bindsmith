# GENERATED BY bindsmith — do not edit.
#
# What the macos binding needs at build time. Add
# these lines to your podspec (macos/<plugin>.podspec),
# once:
#
#     s.source_files = 'Classes/**/*.{h,m}', '../lib/src/generated/macos/swift.g.m'
#     s.frameworks = 'Foundation'
#
# The glue must be compiled — `Classes/**` is where Flutter
# plugins keep native sources. Commit the generated `.m` beside
# the Dart binding and point `source_files` at both.
#
# And let Flutter build this as an FFI plugin, in pubspec.yaml:
#
#     flutter:
#       plugin:
#         platforms:
#           macos:
#             ffiPlugin: true

s.source_files = 'Classes/**/*.{h,m}', '../lib/src/generated/macos/swift.g.m'
s.frameworks = 'Foundation'
